# Fidel Assistant — Backend
# Copier vers .env et renseigner les valeurs. Ne jamais committer .env.

APP_NAME=Fidel Assistant
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Production API : https://educampro.edu.cm
PUBLIC_BASE_URL=http://localhost:8000

# Neon Postgres — connection string POOLÉE
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?ssl=require

# JWT — générer une clé longue et aléatoire en production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP / sécurité
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_MAX_PER_HOUR=5
TEMP_TOKEN_EXPIRE_MINUTES=15
PASSWORD_MIN_LENGTH=8
CGU_CURRENT_VERSION=v1.0

# Google OAuth — voir docs/google-auth-setup.md
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=

# CORS
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://educampro.edu.cm

# Resend (emails OTP) — domaine vérifié : educampro.edu.cm
RESEND_API_KEY=
EMAIL_FROM=Fidel Assistant <noreply@educampro.edu.cm>
