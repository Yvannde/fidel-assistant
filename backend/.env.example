# Fidel Assistant — Backend
# Copier vers .env et renseigner les valeurs. Ne jamais committer .env.

APP_NAME=Fidel Assistant
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Production : https://educampro.edu.cm
PUBLIC_BASE_URL=http://localhost:8000

# Neon Postgres — utiliser la connection string POOLÉE
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?ssl=require

# JWT — générer une clé longue et aléatoire en production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Google OAuth (IdP) — Client IDs Google Cloud Console
# Audience acceptées pour la vérif de l'id_token (Android / iOS / Web)
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=

# CORS — origines autorisées (séparées par des virgules)
# Prod : inclure https://educampro.edu.cm
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://educampro.edu.cm

# Email (OTP) — laisser vide en dev pour logger l'OTP au lieu d'envoyer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@fidel.local
